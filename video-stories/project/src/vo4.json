 ],
 "lines": [
  {
   "i": 0,
   "text": "Летом они проходили под этой аркой каждый день.",
   "start": 2.4,
   "end": 6.196
  },
  {
   "i": 1,
   "text": "Она держала его под руку.",
   "start": 6.508,
   "end": 8.654
  },
  {
   "i": 2,
   "text": "А он, железный рыцарь, шёл тише, чтобы не греметь.",
   "start": 8.929,
   "end": 13.184
  },
  {
   "i": 3,
   "text": "Она смеялась, что броня тяжелее его слов.",
   "start": 13.489,
   "end": 17.191
  },
  {
   "i": 4,
   "text": "А он обещал ей одно: вернуться до первого снега.",
   "start": 17.521,
   "end": 21.615
  },
  {
   "i": 5,
   "text": "Потом пришла война.",
   "start": 21.88,
   "end": 23.721
  },
  {
   "i": 6,
   "text": "И лето закончилось раньше срока.",
   "start": 23.937,
   "end": 26.913
  },
  {
   "i": 7,
   "text": "Он вернулся, когда снег уже лёг.",
   "start": 27.211,
   "end": 29.923
  },
  {
   "i": 8,
   "text": "Вернулся один.",
   "start": 30.246,
   "end": 31.872
  },
  {
   "i": 9,
   "text": "Арка стояла на том же месте.",
   "start": 32.125,
   "end": 34.519
  },
  {
   "i": 10,
   "text": "Но под ней никто не ждал.",
   "start": 34.802,
   "end": 37.061
  },
  {
   "i": 11,
   "text": "Он нашёл цветы, которые она держала в тот день.",
   "start": 37.355,
   "end": 40.684
  },
  {
   "i": 12,
   "text": "Замёрзшие.",
   "start": 40.981,
   "end": 42.531
  },
  {
   "i": 13,
   "text": "Тихие.",
   "start": 42.834,
   "end": 43.888
  },
  {
   "i": 14,
   "text": "Он не плакал.",
   "start": 44.201,
   "end": 45.554
  },
  {
   "i": 15,
   "text": "Рыцари не плачут.",
   "start": 45.811,
   "end": 47.499
  },
  {
   "i": 16,
   "text": "Он просто стоял, пока метель не стёрла его следы.",
   "start": 47.812,
   "end": 51.834
  },
  {
   "i": 17,
   "text": "А рядом тянулась только одна цепочка.",
   "start": 52.101,
   "end": 55.07
  },
  {
   "i": 18,
   "text": "Он выполнил обещание.",
   "start": 55.339,
   "end": 57.667
  },
  {
   "i": 19,
   "text": "Вернулся до первого снега.",
   "start": 57.703,
   "end": 60.238
  },
  {
   "i": 20,
   "text": "Просто слишком поздно.",
   "start": 60.497,
   "end": 62.495
  }
 ]
}