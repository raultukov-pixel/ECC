 ],
 "lines": [
  {
   "i": 0,
   "scene": "road",
   "text": "Сказку о трёх братьях знают все.",
   "start": 4.6,
   "end": 7.529
  },
  {
   "i": 1,
   "scene": "road",
   "text": "Но о старшем в ней — всего несколько строк.",
   "start": 7.979,
   "end": 11.045
  },
  {
   "i": 2,
   "scene": "youth",
   "text": "Его звали Антиох.",
   "start": 12.845,
   "end": 14.77
  },
  {
   "i": 3,
   "scene": "youth",
   "text": "С детства он знал один язык — язык поединка.",
   "start": 15.37,
   "end": 19.076
  },
  {
   "i": 4,
   "scene": "youth",
   "text": "И лишь однажды был побеждён.",
   "start": 19.626,
   "end": 21.721
  },
  {
   "i": 5,
   "scene": "youth",
   "text": "Это поражение он носил в себе долгие годы, как занозу.",
   "start": 22.221,
   "end": 26.825
  },
  {
   "i": 6,
   "scene": "bridge",
   "text": "Когда на мосту Смерть предложила братьям награду, он не колебался.",
   "start": 28.725,
   "end": 33.651
  },
  {
   "i": 7,
   "scene": "bridge",
   "text": "Он попросил палочку, достойную того, кто одолел саму Смерть.",
   "start": 34.151,
   "end": 39.485
  },
  {
   "i": 8,
   "scene": "elder",
   "text": "И Смерть сломала ветвь бузины, что росла у воды.",
   "start": 41.985,
   "end": 45.774
  },
  {
   "i": 9,
   "scene": "journey",
   "text": "С этой палочкой он пришёл в далёкую деревню — туда, где жил его давний враг.",
   "start": 48.174,
   "end": 53.74
  },
  {
   "i": 10,
   "scene": "duel",
   "text": "Поединок был коротким.",
   "start": 56.24,
   "end": 58.103
  },
  {
   "i": 11,
   "scene": "duel",
   "text": "Враг пал.",
   "start": 59.703,
   "end": 60.877
  },
  {
   "i": 12,
   "scene": "duel",
   "text": "А заноза… осталась.",
   "start": 61.977,
   "end": 64.615
  },
  {
   "i": 13,
   "scene": "inn",
   "text": "В ту ночь на постоялом дворе он пил вино и кричал каждому, кто слушал:",
   "start": 66.815,
   "end": 72.28
  },
  {
   "i": 14,
   "scene": "inn",
   "text": "«Меня не победить!",
   "start": 72.68,
   "end": 74.098
  },
  {
   "i": 15,
   "scene": "inn",
   "text": "Палочку мне дала сама Смерть!»",
   "start": 74.398,
   "end": 76.697
  },
  {
   "i": 16,
   "scene": "inn",
   "text": "И его услышали.",
   "start": 77.897,
   "end": 79.402
  },
  {
   "i": 17,
   "scene": "thief",
   "text": "Когда он уснул, к постели подкрался вор.",
   "start": 82.002,
   "end": 85.386
  },
  {
   "i": 18,
   "scene": "thief",
   "text": "Он забрал палочку.",
   "start": 86.286,
   "end": 88.004
  },
  {
   "i": 19,
   "scene": "thief",
   "text": "А заодно — перерезал старшему брату горло.",
   "start": 88.804,
   "end": 92.248
  },
  {
   "i": 20,
   "scene": "end",
   "text": "Так Смерть получила первого из братьев.",
   "start": 95.648,
   "end": 98.613
  }
 ]
}