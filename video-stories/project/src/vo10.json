{
 "total": 73.63,
 "scenes": [
  {
   "name": "all",
   "start": 0,
   "end": 73.63,
   "lines": []
  }
 ],
 "lines": [
  {
   "i": 0,
   "text": "Все дети в нашем районе обходили этот дом стороной.",
   "start": 1.011,
   "end": 5.188
  },
  {
   "i": 1,
   "text": "Говорили, что он живой.",
   "start": 5.343,
   "end": 7.351
  },
  {
   "i": 2,
   "text": "Что смотрит из окон.",
   "start": 7.603,
   "end": 9.503
  },
  {
   "i": 3,
   "text": "Что по ночам в нём кто-то плачет.",
   "start": 9.728,
   "end": 12.481
  },
  {
   "i": 4,
   "text": "Хозяин, старик, никого не пускал к забору.",
   "start": 12.769,
   "end": 16.471
  },
  {
   "i": 5,
   "text": "Кричал на каждого, кто подходил близко.",
   "start": 16.694,
   "end": 19.865
  },
  {
   "i": 6,
   "text": "Мы думали, что он злой.",
   "start": 20.13,
   "end": 22.1
  },
  {
   "i": 7,
   "text": "Никто не знал, что этот дом он построил сам.",
   "start": 22.241,
   "end": 26.2
  },
  {
   "i": 8,
   "text": "Своими руками.",
   "start": 26.279,
   "end": 27.866
  },
  {
   "i": 9,
   "text": "Каждое окно он ставил так, как она любила, чтобы утром в кухню падало солнце.",
   "start": 28.08,
   "end": 34.122
  },
  {
   "i": 10,
   "text": "Она так и не успела в нём пожить.",
   "start": 34.394,
   "end": 36.967
  },
  {
   "i": 11,
   "text": "Он остался.",
   "start": 37.201,
   "end": 38.645
  },
  {
   "i": 12,
   "text": "Не потому что не мог уйти.",
   "start": 38.723,
   "end": 41.074
  },
  {
   "i": 13,
   "text": "А потому что в этом доме всё ещё стояла её чашка.",
   "start": 41.291,
   "end": 45.637
  },
  {
   "i": 14,
   "text": "Висел её платок.",
   "start": 45.802,
   "end": 47.519
  },
  {
   "i": 15,
   "text": "Каждый вечер он зажигал свет в её любимом окне.",
   "start": 47.793,
   "end": 51.351
  },
  {
   "i": 16,
   "text": "Мы думали, что дом смотрит на нас.",
   "start": 51.554,
   "end": 54.429
  },
  {
   "i": 17,
   "text": "А он просто ждал её.",
   "start": 54.554,
   "end": 56.48
  },
  {
   "i": 18,
   "text": "Теперь я иногда прохожу мимо.",
   "start": 56.787,
   "end": 59.338
  },
  {
   "i": 19,
   "text": "Останавливаюсь у забора.",
   "start": 59.468,
   "end": 61.734
  },
  {
   "i": 20,
   "text": "И тихо говорю: «Простите нас».",
   "start": 61.877,
   "end": 64.609
  },
  {
   "i": 21,
   "text": "Злым был не дом.",
   "start": 64.907,
   "end": 66.69
  },
  {
   "i": 22,
   "text": "Злыми были мы.",
   "start": 66.796,
   "end": 68.63
  }
 ]
}