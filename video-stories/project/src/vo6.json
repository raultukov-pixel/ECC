{
 "total": 77.268,
 "scenes": [
  {
   "name": "all",
   "start": 0,
   "end": 77.268,
   "lines": []
  }
 ],
 "lines": [
  {
   "i": 0,
   "text": "Каждое утро он ставил на стол две чашки.",
   "start": 2.4,
   "end": 5.613
  },
  {
   "i": 1,
   "text": "Одну для себя.",
   "start": 5.894,
   "end": 7.469
  },
  {
   "i": 2,
   "text": "Другую для неё.",
   "start": 7.735,
   "end": 9.215
  },
  {
   "i": 3,
   "text": "Она любила чай слишком крепкий.",
   "start": 9.53,
   "end": 12.011
  },
  {
   "i": 4,
   "text": "Он ворчал, но всегда заваривал так, как она хотела.",
   "start": 12.285,
   "end": 16.687
  },
  {
   "i": 5,
   "text": "Потом она уехала.",
   "start": 16.961,
   "end": 18.539
  },
  {
   "i": 6,
   "text": "«Ненадолго», сказала она.",
   "start": 18.794,
   "end": 20.82
  },
  {
   "i": 7,
   "text": "Он не стал убирать вторую чашку.",
   "start": 21.092,
   "end": 23.505
  },
  {
   "i": 8,
   "text": "Утром наливал чай в обе.",
   "start": 23.745,
   "end": 25.955
  },
  {
   "i": 9,
   "text": "Одна остывала нетронутой.",
   "start": 26.254,
   "end": 28.307
  },
  {
   "i": 10,
   "text": "Он пил свой и смотрел, как над её чашкой тает пар.",
   "start": 28.596,
   "end": 33.367
  },
  {
   "i": 11,
   "text": "Прошла неделя.",
   "start": 33.666,
   "end": 35.091
  },
  {
   "i": 12,
   "text": "Потом месяц.",
   "start": 35.357,
   "end": 36.676
  },
  {
   "i": 13,
   "text": "Потом он перестал считать.",
   "start": 36.986,
   "end": 38.954
  },
  {
   "i": 14,
   "text": "Соседка сказала однажды:",
   "start": 39.233,
   "end": 41.274
  },
  {
   "i": 15,
   "text": "«Уберите вы эту чашку.",
   "start": 41.268,
   "end": 43.157
  },
  {
   "i": 16,
   "text": "Так нельзя».",
   "start": 43.425,
   "end": 44.611
  },
  {
   "i": 17,
   "text": "Он улыбнулся и ничего не ответил.",
   "start": 44.872,
   "end": 47.66
  },
  {
   "i": 18,
   "text": "А в один из дней он проснулся и впервые не вспомнил про вторую.",
   "start": 47.919,
   "end": 52.373
  },
  {
   "i": 19,
   "text": "Налил чай в одну чашку.",
   "start": 52.645,
   "end": 54.735
  },
  {
   "i": 20,
   "text": "Сел.",
   "start": 54.998,
   "end": 55.79
  },
  {
   "i": 21,
   "text": "И понял, что пара над столом только один.",
   "start": 55.998,
   "end": 59.225
  },
  {
   "i": 22,
   "text": "Он долго сидел.",
   "start": 59.484,
   "end": 61.004
  },
  {
   "i": 23,
   "text": "Потом встал.",
   "start": 61.262,
   "end": 62.465
  },
  {
   "i": 24,
   "text": "Взял её чашку.",
   "start": 62.715,
   "end": 64.362
  },
  {
   "i": 25,
   "text": "Вымыл.",
   "start": 64.634,
   "end": 65.53
  },
  {
   "i": 26,
   "text": "И убрал в шкаф.",
   "start": 65.813,
   "end": 67.535
  },
  {
   "i": 27,
   "text": "Тихо. Не хлопнув дверцей.",
   "start": 67.881,
   "end": 70.57
  }
 ]
}