 "total": 72.038,
 "scenes": [
  {
   "name": "all",
   "start": 0,
   "end": 72.038,
   "lines": []
  }
 ],
 "lines": [
  {
   "i": 0,
   "text": "Он проходил мимо этой двери каждый вечер.",
   "start": 0.9,
   "end": 4.004
  },
  {
   "i": 1,
   "text": "Уже много лет.",
   "start": 4.265,
   "end": 5.841
  },
  {
   "i": 2,
   "text": "Замедлял шаг.",
   "start": 6.087,
   "end": 7.552
  },
  {
   "i": 3,
   "text": "Смотрел на свет в окнах.",
   "start": 7.737,
   "end": 9.752
  },
  {
   "i": 4,
   "text": "И шёл дальше.",
   "start": 9.971,
   "end": 11.301
  },
  {
   "i": 5,
   "text": "Он говорил себе:",
   "start": 11.578,
   "end": 13.003
  },
  {
   "i": 6,
   "text": "«Мне туда нельзя.",
   "start": 12.995,
   "end": 14.429
  },
  {
   "i": 7,
   "text": "Не после всего, что я наделал».",
   "start": 14.627,
   "end": 17.007
  },
  {
   "i": 8,
   "text": "Он помнил каждый свой грех.",
   "start": 17.303,
   "end": 19.752
  },
  {
   "i": 9,
   "text": "И думал, что для таких, как он, эта дверь давно закрыта.",
   "start": 20.014,
   "end": 24.082
  },
  {
   "i": 10,
   "text": "Зимой он проходил быстрее.",
   "start": 24.326,
   "end": 26.594
  },
  {
   "i": 11,
   "text": "Летом — медленнее.",
   "start": 26.832,
   "end": 28.77
  },
  {
   "i": 12,
   "text": "А дверь все эти годы была открыта.",
   "start": 28.986,
   "end": 31.734
  },
  {
   "i": 13,
   "text": "Каждый вечер.",
   "start": 32.025,
   "end": 33.268
  },
  {
   "i": 14,
   "text": "Для всех.",
   "start": 33.469,
   "end": 34.678
  },
  {
   "i": 15,
   "text": "Свет в окнах горел и для него тоже.",
   "start": 34.949,
   "end": 37.871
  },
  {
   "i": 16,
   "text": "Однажды он остановился.",
   "start": 38.102,
   "end": 40.555
  },
  {
   "i": 17,
   "text": "Долго стоял на пороге.",
   "start": 40.805,
   "end": 42.732
  },
  {
   "i": 18,
   "text": "Руки дрожали.",
   "start": 42.92,
   "end": 44.242
  },
  {
   "i": 19,
   "text": "И кто-то рядом молча подвинулся, освобождая ему место.",
   "start": 44.518,
   "end": 48.825
  },
  {
   "i": 20,
   "text": "Ничего не спросил.",
   "start": 49.096,
   "end": 50.614
  },
  {
   "i": 21,
   "text": "Не упрекнул.",
   "start": 50.845,
   "end": 52.102
  },
  {
   "i": 22,
   "text": "Он опустил голову.",
   "start": 52.335,
   "end": 54.085
  },
  {
   "i": 23,
   "text": "И впервые за много лет не стал уходить.",
   "start": 54.321,
   "end": 57.27
  },
  {
   "i": 24,
   "text": "Сказано: «Не отчаивайтесь в милости Аллаха».",
   "start": 57.576,
   "end": 61.257
  },
  {
   "i": 25,
   "text": "Дверь никогда не была закрыта.",
   "start": 61.563,
   "end": 64.134
  },
  {
   "i": 26,
   "text": "Закрытой её считал только он.",
   "start": 64.401,
   "end": 67.038
  }
 ]
}