 "lines": [
  {
   "i": 0,
   "scene": "last",
   "text": "Остался Младший.",
   "start": 5.2,
   "end": 6.985
  },
  {
   "i": 1,
   "scene": "last",
   "text": "Самый тихий и самый мудрый из трёх.",
   "start": 7.535,
   "end": 10.847
  },
  {
   "i": 2,
   "scene": "doubt",
   "text": "Игнотус не верил Смерти.",
   "start": 12.647,
   "end": 15.196
  },
  {
   "i": 3,
   "scene": "doubt",
   "text": "Он видел, как ласково она улыбалась его братьям.",
   "start": 15.696,
   "end": 19.064
  },
  {
   "i": 4,
   "scene": "doubt",
   "text": "Слишком ласково.",
   "start": 19.664,
   "end": 21.297
  },
  {
   "i": 5,
   "scene": "wish",
   "text": "Ему не нужна была победа над ней. Он хотел только одного: прожить свою жизнь.",
   "start": 23.497,
   "end": 29.375
  },
  {
   "i": 6,
   "scene": "wish",
   "text": "И он попросил так:",
   "start": 30.075,
   "end": 31.642
  },
  {
   "i": 7,
   "scene": "wish",
   "text": "уйти отсюда, чтобы Смерть не пошла следом.",
   "start": 31.942,
   "end": 35.918
  },
  {
   "i": 8,
   "scene": "pause",
   "text": "Смерть помедлила.",
   "start": 38.318,
   "end": 39.897
  },
  {
   "i": 9,
   "scene": "pause",
   "text": "И ей было неприятно отдавать то, что принадлежало ей самой.",
   "start": 40.497,
   "end": 45.054
  },
  {
   "i": 10,
   "scene": "cloak",
   "text": "Но она сняла с себя плащ.",
   "start": 47.554,
   "end": 49.781
  },
  {
   "i": 11,
   "scene": "cloak",
   "text": "Плащ, под которым можно скрыться даже от неё.",
   "start": 50.381,
   "end": 54.183
  },
  {
   "i": 12,
   "scene": "years",
   "text": "Игнотус накинул его и пошёл прочь.",
   "start": 56.983,
   "end": 60.054
  },
  {
   "i": 13,
   "scene": "years",
   "text": "Он прожил долгую, тихую, счастливую жизнь.",
   "start": 60.654,
   "end": 64.306
  },
  {
   "i": 14,
   "scene": "son",
   "text": "Передал плащ сыну, и тот понял, что это дар, а не оружие.",
   "start": 67.906,
   "end": 72.189
  },
  {
   "i": 15,
   "scene": "hour",
   "text": "А когда пришёл его час, Игнотус снял плащ.",
   "start": 75.589,
   "end": 79.553
  },
  {
   "i": 16,
   "scene": "hour",
   "text": "И поприветствовал Смерть как старого друга.",
   "start": 80.153,
   "end": 83.392
  },
  {
   "i": 17,
   "scene": "end",
   "text": "Они ушли вместе.",
   "start": 86.392,
   "end": 88.113
  },
  {
   "i": 18,
   "scene": "end",
   "text": "На равных.",
   "start": 88.713,
   "end": 89.975
  },
  {
   "i": 19,
   "scene": "end",
   "text": "Так закончилась сказка о трёх братьях.",
   "start": 91.475,
   "end": 94.681
  }
 ]
}