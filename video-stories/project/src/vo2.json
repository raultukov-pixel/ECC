 "lines": [
  {
   "i": 0,
   "scene": "bridge",
   "text": "Старший пал первым.",
   "start": 5.2,
   "end": 7.143
  },
  {
   "i": 1,
   "scene": "bridge",
   "text": "Но Смерть всё ещё стояла на мосту.",
   "start": 7.693,
   "end": 10.683
  },
  {
   "i": 2,
   "scene": "kadm",
   "text": "Средний брат, Кадм, был горд и жесток.",
   "start": 12.583,
   "end": 16.345
  },
  {
   "i": 3,
   "scene": "kadm",
   "text": "Он видел, как Смерть можно перехитрить, и захотел унизить её ещё раз.",
   "start": 16.845,
   "end": 22.16
  },
  {
   "i": 4,
   "scene": "ask",
   "text": "Он попросил то, чего не давал никто:",
   "start": 24.06,
   "end": 26.927
  },
  {
   "i": 5,
   "scene": "ask",
   "text": "вернуть тех, кого она уже забрала.",
   "start": 27.277,
   "end": 30.347
  },
  {
   "i": 6,
   "scene": "stone",
   "text": "Смерть подняла с берега камень.",
   "start": 32.647,
   "end": 35.252
  },
  {
   "i": 7,
   "scene": "stone",
   "text": "Повернула его в руке трижды.",
   "start": 35.752,
   "end": 37.936
  },
  {
   "i": 8,
   "scene": "she",
   "text": "И перед ним появилась она.",
   "start": 40.536,
   "end": 42.652
  },
  {
   "i": 9,
   "scene": "she",
   "text": "Девушка, которую он любил и которую потерял слишком рано.",
   "start": 43.252,
   "end": 47.671
  },
  {
   "i": 10,
   "scene": "veil",
   "text": "Но она была тихой и холодной.",
   "start": 50.171,
   "end": 53.108
  },
  {
   "i": 11,
   "scene": "veil",
   "text": "Она была не здесь и не там.",
   "start": 53.608,
   "end": 55.989
  },
  {
   "i": 12,
   "scene": "veil",
   "text": "Между ними осталась стена, которую нельзя пройти.",
   "start": 56.489,
   "end": 60.253
  },
  {
   "i": 13,
   "scene": "calls",
   "text": "Он звал её каждую ночь.",
   "start": 62.653,
   "end": 64.761
  },
  {
   "i": 14,
   "scene": "calls",
   "text": "Она отвечала взглядом, и это было страшнее молчания.",
   "start": 65.361,
   "end": 69.705
  },
  {
   "i": 15,
   "scene": "fade",
   "text": "Он перестал есть.",
   "start": 72.005,
   "end": 73.595
  },
  {
   "i": 16,
   "scene": "fade",
   "text": "Перестал спать.",
   "start": 74.145,
   "end": 75.529
  },
  {
   "i": 17,
   "scene": "fade",
   "text": "Перестал отличать день от ночи.",
   "start": 76.079,
   "end": 78.584
  },
  {
   "i": 18,
   "scene": "fade",
   "text": "И однажды понял: чтобы быть рядом с ней, нужно уйти туда, где она.",
   "start": 79.184,
   "end": 84.388
  },
  {
   "i": 19,
   "scene": "end",
   "text": "Так Смерть получила второго из братьев.",
   "start": 87.788,
   "end": 90.704
  }
 ]
}