{
 "total": 111.091,
 "scenes": [
  {
   "name": "all",
   "start": 0,
   "end": 111.091,
   "lines": []
  }
 ],
 "lines": [
  {
   "i": 0,
   "text": "Последний звонок от мамы он сбросил.",
   "start": 0.7,
   "end": 3.598
  },
  {
   "i": 1,
   "text": "Просто был занят.",
   "start": 3.901,
   "end": 5.504
  },
  {
   "i": 2,
   "text": "«Перезвоню», — подумал он.",
   "start": 5.84,
   "end": 7.864
  },
  {
   "i": 3,
   "text": "Она звонила ему в обед.",
   "start": 8.123,
   "end": 9.916
  },
  {
   "i": 4,
   "text": "Он был на совещании.",
   "start": 10.253,
   "end": 12.061
  },
  {
   "i": 5,
   "text": "Вечером написала: «Как ты?»",
   "start": 12.323,
   "end": 14.664
  },
  {
   "i": 6,
   "text": "Он ответил одним словом: «Занят».",
   "start": 14.863,
   "end": 17.519
  },
  {
   "i": 7,
   "text": "И добавил: «Потом».",
   "start": 17.864,
   "end": 19.732
  },
  {
   "i": 8,
   "text": "Она не обиделась.",
   "start": 20.003,
   "end": 21.494
  },
  {
   "i": 9,
   "text": "Она вообще никогда не обижалась.",
   "start": 21.775,
   "end": 24.231
  },
  {
   "i": 10,
   "text": "Просто стала писать короче.",
   "start": 24.56,
   "end": 26.91
  },
  {
   "i": 11,
   "text": "«Поел?»",
   "start": 27.271,
   "end": 28.123
  },
  {
   "i": 12,
   "text": "«Не замёрз?»",
   "start": 28.329,
   "end": 29.471
  },
  {
   "i": 13,
   "text": "В субботу она позвонила снова.",
   "start": 29.822,
   "end": 32.11
  },
  {
   "i": 14,
   "text": "Он не взял.",
   "start": 32.375,
   "end": 33.627
  },
  {
   "i": 15,
   "text": "Подумал: «Завтра».",
   "start": 33.882,
   "end": 35.742
  },
  {
   "i": 16,
   "text": "Завтра были друзья.",
   "start": 35.972,
   "end": 37.969
  },
  {
   "i": 17,
   "text": "Потом отчёт.",
   "start": 38.269,
   "end": 39.56
  },
  {
   "i": 18,
   "text": "Потом дедлайн.",
   "start": 39.87,
   "end": 41.531
  },
  {
   "i": 19,
   "text": "«Потом» у него всегда было впереди.",
   "start": 41.767,
   "end": 44.245
  },
  {
   "i": 20,
   "text": "На Новый год она прислала открытку.",
   "start": 44.501,
   "end": 47.17
  },
  {
   "i": 21,
   "text": "Обычную, с ёлкой.",
   "start": 47.462,
   "end": 49.41
  },
  {
   "i": 22,
   "text": "И подписала от руки,",
   "start": 49.726,
   "end": 51.368
  },
  {
   "i": 23,
   "text": "неровным почерком:",
   "start": 51.397,
   "end": 52.909
  },
  {
   "i": 24,
   "text": "«Приезжай, сынок.",
   "start": 53.04,
   "end": 54.413
  },
  {
   "i": 25,
   "text": "Я пирог испеку».",
   "start": 54.949,
   "end": 56.833
  },
  {
   "i": 26,
   "text": "Он улыбнулся.",
   "start": 57.119,
   "end": 58.404
  },
  {
   "i": 27,
   "text": "Положил открытку на стол.",
   "start": 58.644,
   "end": 60.575
  },
  {
   "i": 28,
   "text": "«Приеду. Весной».",
   "start": 60.9,
   "end": 63.212
  },
  {
   "i": 29,
   "text": "Весной она позвонила в последний раз.",
   "start": 63.549,
   "end": 66.726
  },
  {
   "i": 30,
   "text": "Он увидел её имя на экране.",
   "start": 67.036,
   "end": 69.534
  },
  {
   "i": 31,
   "text": "И нажал «отклонить».",
   "start": 69.807,
   "end": 71.235
  },
  {
   "i": 32,
   "text": "Через два часа позвонила соседка.",
   "start": 71.568,
   "end": 74.276
  },
  {
   "i": 33,
   "text": "Он приехал в тот же вечер.",
   "start": 74.525,
   "end": 76.615
  },
  {
   "i": 34,
   "text": "В квартире было тихо.",
   "start": 76.918,
   "end": 78.886
  },
  {
   "i": 35,
   "text": "На плите стоял пирог.",
   "start": 79.149,
   "end": 81.014
  },
  {
   "i": 36,
   "text": "Остывший.",
   "start": 81.281,
   "end": 82.522
  },
  {
   "i": 37,
   "text": "Для него.",
   "start": 82.87,
   "end": 83.959
  },
  {
   "i": 38,
   "text": "Теперь он часто достаёт телефон.",
   "start": 84.201,
   "end": 86.952
  },
  {
   "i": 39,
   "text": "Находит в истории вызовов её имя",
   "start": 87.171,
   "end": 90.161
  },
  {
   "i": 40,
   "text": "и рядом красную стрелку.",
   "start": 90.444,
   "end": 92.65
  },
  {
   "i": 41,
   "text": "Пропущенный.",
   "start": 93.012,
   "end": 94.225
  },
  {
   "i": 42,
   "text": "Один.",
   "start": 94.658,
   "end": 95.509
  },
  {
   "i": 43,
   "text": "Единственный, который уже не перезвонить.",
   "start": 95.775,
   "end": 98.773
  },
  {
   "i": 44,
   "text": "Позвони маме.",
   "start": 99.075,
   "end": 100.465
  },
  {
   "i": 45,
   "text": "Прямо сейчас.",
   "start": 100.748,
   "end": 102.045
  },
  {
   "i": 46,
   "text": "Пока она ещё может взять трубку.",
   "start": 102.33,
   "end": 105.091
  }
 ]
}