 ],
 "lines": [
  {
   "i": 0,
   "text": "Он писал ей каждый вечер.",
   "start": 2.4,
   "end": 4.553
  },
  {
   "i": 1,
   "text": "Садился за стол, зажигал свечу и начинал:",
   "start": 4.882,
   "end": 8.423
  },
  {
   "i": 2,
   "text": "«Здравствуй».",
   "start": 8.658,
   "end": 9.683
  },
  {
   "i": 3,
   "text": "Потом вспоминал, как они расстались.",
   "start": 10.089,
   "end": 12.608
  },
  {
   "i": 4,
   "text": "Скомкивал лист.",
   "start": 12.966,
   "end": 14.322
  },
  {
   "i": 5,
   "text": "И бросал в огонь.",
   "start": 14.802,
   "end": 16.269
  },
  {
   "i": 6,
   "text": "Он думал: завтра.",
   "start": 16.595,
   "end": 18.588
  },
  {
   "i": 7,
   "text": "Завтра я найду правильные слова.",
   "start": 18.899,
   "end": 22.189
  },
  {
   "i": 8,
   "text": "И отправлю.",
   "start": 22.515,
   "end": 23.632
  },
  {
   "i": 9,
   "text": "Завтра превращалось в неделю.",
   "start": 24.025,
   "end": 26.706
  },
  {
   "i": 10,
   "text": "Неделя — в год.",
   "start": 27.066,
   "end": 28.357
  },
  {
   "i": 11,
   "text": "А пепел ложился на подоконник, как первый снег.",
   "start": 28.753,
   "end": 32.447
  },
  {
   "i": 12,
   "text": "Много лет спустя он наконец дописал письмо до конца.",
   "start": 32.788,
   "end": 37.591
  },
  {
   "i": 13,
   "text": "Запечатал.",
   "start": 37.911,
   "end": 39.165
  },
  {
   "i": 14,
   "text": "И сам отнёс на почту.",
   "start": 39.484,
   "end": 41.589
  },
  {
   "i": 15,
   "text": "Через месяц конверт вернулся.",
   "start": 41.903,
   "end": 44.555
  },
  {
   "i": 16,
   "text": "Нетронутый.",
   "start": 44.911,
   "end": 46.181
  },
  {
   "i": 17,
   "text": "На нём была одна строчка:",
   "start": 46.532,
   "end": 48.525
  },
  {
   "i": 18,
   "text": "«Адресат выбыл».",
   "start": 48.517,
   "end": 49.941
  },
  {
   "i": 19,
   "text": "Он долго держал его в руках.",
   "start": 50.265,
   "end": 52.548
  },
  {
   "i": 20,
   "text": "Потом взял чистый лист.",
   "start": 53.016,
   "end": 55.034
  },
  {
   "i": 21,
   "text": "И снова написал:",
   "start": 55.405,
   "end": 56.915
  },
  {
   "i": 22,
   "text": "«Здравствуй».",
   "start": 56.908,
   "end": 57.96
  }
 ]
}